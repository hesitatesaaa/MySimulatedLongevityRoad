      "BoolVal": true,
      "Callback": "MclslConfig:EnableFactionCommissionsCallBack"
    },
    {
      "Id": "MCLSL_config_enable_ancient_lineage_announcements",
      "Name": "显示仙道传承公告",
      "Description": "控制个人仙道法脉兴盛的额外纪事；道统兴衰与功法传承记录不受影响，原版历史由独立开关控制。",
      "Type": "SWITCH",
      "BoolVal": false,
      "Callback": "MclslConfig:EnableAncientLineageAnnouncementsCallBack"
    },
    {
      "Id": "MCLSL_config_lineage_native_history",
      "Name": "将传承事件写入原版历史",
      "Description": "控制新旧法道统兴衰、功法入录、失传和复现等符合历史重要性规则的消息是否写入原版历史。关闭后玄黄仙录与传承数据仍保留；已有历史不删除，重新开启不补发。",
      "Type": "SWITCH",
      "BoolVal": true,
      "Callback": "MclslConfig:LineageNativeHistoryCallBack"
