{
  "ConfigItems": [
    {
      "Id": "MCLSL_config_annual_backpressure",
      "Name": "年度积压自动限速",
      "Description": "默认开启。年度结算积压时临时降低时间推进速度，追上后自动恢复玩家所选倍速。",
      "Type": "SWITCH",
      "BoolVal": true,
      "Callback": "MclslConfig:AnnualBackpressureCallBack"
    },
    {
