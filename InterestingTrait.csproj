<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      WorldBox runs the mod loader inside Unity's Mono runtime. Publishing a
      net6.0 assembly leaves System.Runtime 6.x references in the mod and the
      original game refuses to load it. netstandard2.1 keeps the modern API
      surface used by this code while resolving against the game's
      netstandard.dll.
    -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>MySimulatedLongevityRoad</AssemblyName>
    <RootNamespace>MySimulatedLongevityRoad</RootNamespace>
    <LangVersion>11</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <NoWarn>$(NoWarn);MSB3277;CS0162;CS0219</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WorldBoxRoot Condition="'$(WorldBoxRoot)' == ''">..\..\worldbox_Data</WorldBoxRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(WorldBoxRoot)\StreamingAssets\mods\NML\Assemblies\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(WorldBoxRoot)\StreamingAssets\mods\NML\Assembly-CSharp-Publicized.dll</HintPath>
    </Reference>
    <Reference Include="NeoModLoader">
      <HintPath>$(WorldBoxRoot)\StreamingAssets\mods\NeoModLoader.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(WorldBoxRoot)\Managed\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="System.Net.Http">
      <HintPath>$(WorldBoxRoot)\Managed\System.Net.Http.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(WorldBoxRoot)\Managed\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(WorldBoxRoot)\Managed\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(WorldBoxRoot)\Managed\UnityEngine.IMGUIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(WorldBoxRoot)\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(WorldBoxRoot)\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(WorldBoxRoot)\Managed\UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(WorldBoxRoot)\Managed\UnityEngine.UIModule.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove=".recovered\**\*.cs" />
    <Compile Remove="code_broken_*\**\*.cs" />
    <Compile Remove="xj_0_7_announce_scan\**\*.cs" />
    <Compile Remove="references\WorldBoxGameDecompiled\**\*.cs" />
  </ItemGroup>

</Project>
